<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#F5F5F5"
    tools:context=".Clients.PaymentReceipt">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/receipt_background"
        android:padding="24dp">
        <ImageView
            android:id="@+id/btn_printfile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="15dp"
            android:contentDescription="print"
            android:src="@drawable/ic_print" />

        <!-- Company Information -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Redbubble Merchandise Branding"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="#333"
            android:layout_gravity="center"
            android:paddingBottom="4dp"
            android:fontFamily="sans-serif"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Contact: +254771045000"
            android:textSize="16sp"
            android:gravity="center"
            android:textColor="#555"
            android:layout_gravity="center"
            android:fontFamily="sans-serif"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email: Info@redbubble.com"
            android:textSize="16sp"
            android:gravity="center"
            android:textColor="#555"
            android:layout_gravity="center"
            android:paddingBottom="16dp"
            android:fontFamily="sans-serif"/>

        <!-- Receipt Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Payment Receipt"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="#333"
            android:layout_gravity="center"
            android:paddingBottom="16dp"
            android:fontFamily="sans-serif"/>

        <!-- Receipt Number and Date in Horizontal Layout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/receipt_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Receipt No: RM20-N0"
                android:textSize="18sp"
                android:textColor="#555"
                android:layout_weight="1"
                android:fontFamily="sans-serif"/>

            <TextView
                android:id="@+id/receipt_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Date: "
                android:textSize="18sp"
                android:textColor="#555"
                android:layout_gravity="end"
                android:layout_weight="1"
                android:fontFamily="sans-serif"/>
        </LinearLayout>

        <!-- Booking Details -->
        <TextView
            android:id="@+id/receipt_orderID"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Booking ID: "
            android:textSize="18sp"
            android:textColor="#555"
            android:fontFamily="sans-serif"/>

        <TextView
            android:id="@+id/receipt_clientName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Client Name: "
            android:textSize="18sp"
            android:textColor="#555"
            android:fontFamily="sans-serif"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Product Items"
                    android:textSize="16sp"
                    android:layout_gravity="center"
                    android:textStyle="bold"
                    android:textColor="@color/colorBlack" />

                <include layout="@layout/row_cart_items_header" />

                <!-- List -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:scrollbars="vertical"
                    app:layout_behavior="@string/appbar_scrolling_view_behavior" />
            </LinearLayout>

        <LinearLayout
            android:id="@+id/subtotal_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="#F7F7FA"
            android:elevation="2dp"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/label_subtotal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Subtotal"
                android:textColor="#555555"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/txv_cart_subtotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ksh 0"
                android:textColor="#111111"
                android:textStyle="bold"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txv_ship_fee"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Shipping Fee: 300"
            android:layout_marginTop="4dp"
            android:textSize="18sp"
            android:textColor="#555"
            android:fontFamily="sans-serif"/>

        <TextView
            android:id="@+id/txv_paymentCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Payment Code: "
            android:layout_marginTop="4dp"
            android:textSize="18sp"
            android:textColor="#555"
            android:fontFamily="sans-serif"/>

        <TextView
            android:id="@+id/txv_fee"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:text="Amount: "
            android:textSize="18sp"
            android:textColor="#555"
            android:fontFamily="sans-serif"/>

        <!-- Footer Text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thank you for your payment!"
            android:textSize="16sp"
            android:gravity="center"
            android:textColor="#777"
            android:layout_marginTop="24dp"
            android:layout_gravity="center"
            android:fontFamily="sans-serif"/>

    </LinearLayout>

</ScrollView>