<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="6dp"
    android:backgroundTint="@android:color/white"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Request ID -->
        <TextView
            android:id="@+id/txv_requestID"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Request ID: #12345"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/colorPrimaryDark"
            android:layout_marginBottom="4dp" />

        <!-- Name -->
        <TextView
            android:id="@+id/txv_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Name: John Doe"
            android:textSize="15sp"
            android:textColor="@color/colorBlack"
            android:layout_marginBottom="4dp" />

        <!-- Phone Number -->
        <TextView
            android:id="@+id/txv_phoneNo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Phone: +254 700 000000"
            android:textSize="15sp"
            android:textColor="@color/colorBlack"
            android:layout_marginBottom="4dp" />

        <!-- Item -->
        <TextView
            android:id="@+id/txv_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Item: 3 bags of cement"
            android:textSize="15sp"
            android:textColor="@color/colorBlack"
            android:layout_marginBottom="4dp" />

        <!-- Date -->
        <TextView
            android:id="@+id/txv_requestDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Date: 18 Oct 2025"
            android:textSize="14sp"
            android:textColor="@color/colorBlack"
            android:layout_marginBottom="4dp" />

        <!-- Status -->
        <TextView
            android:id="@+id/txv_requestStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status: Pending"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="@color/colorAccent"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="4dp"
            android:background="#E0E0E0" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
