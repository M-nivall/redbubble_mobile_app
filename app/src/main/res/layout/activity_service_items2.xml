<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".Staff.Technician.ServicesItems">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:id="@+id/card_payment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="12dp"
                android:padding="12dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardElevation="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <!-- Client Details Section -->
                    <TextView
                        android:id="@+id/txv_details"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Client Details"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorPrimaryDark"
                        android:paddingBottom="8dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:background="@android:color/darker_gray"
                        android:layout_marginBottom="10dp"/>

                    <TextView
                        android:id="@+id/txv_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Name: "
                        android:textSize="16sp"
                        android:textColor="@color/colorBlack"
                        android:paddingBottom="4dp" />

                    <TextView
                        android:id="@+id/txv_tell"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Phone No: "
                        android:textSize="16sp"
                        android:textColor="@color/colorBlack"
                        android:paddingBottom="4dp" />

                    <TextView
                        android:id="@+id/txv_county"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="County: "
                        android:textSize="16sp"
                        android:textColor="@color/colorBlack"
                        android:paddingBottom="4dp" />

                    <TextView
                        android:id="@+id/txv_address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Address: "
                        android:textSize="16sp"
                        android:textColor="@color/colorBlack"
                        android:paddingBottom="8dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:background="@android:color/darker_gray"
                        android:layout_marginBottom="10dp"/>

                    <!-- Booking Details Section -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Booking Details"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorPrimaryDark"
                        android:paddingBottom="8dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:background="@android:color/darker_gray"
                        android:layout_marginBottom="10dp"/>

                    <TextView
                        android:id="@+id/txv_bookingID"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Booking ID:"
                        android:textSize="16sp"
                        android:textColor="@color/colorBlack"
                        android:paddingBottom="4dp" />

                    <TextView
                        android:id="@+id/txv_service"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Service: "
                        android:textSize="16sp"
                        android:textColor="@color/colorBlack"
                        android:paddingBottom="4dp" />

                    <TextView
                        android:id="@+id/txv_installation_type"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Installation Type: "
                        android:textSize="16sp"
                        android:textColor="@color/colorBlack"
                        android:paddingBottom="4dp" />

                    <TextView
                        android:id="@+id/txv_expected_date"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Expected Date: "
                        android:textSize="16sp"
                        android:textColor="@color/colorBlack"
                        android:paddingBottom="8dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:background="@android:color/darker_gray"
                        android:layout_marginBottom="10dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center_horizontal"
                    android:background="@android:color/white">

                    <!-- Section for Viewing Architecture Design -->
                    <TextView
                        android:id="@+id/txv_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="View Design"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorPrimary"
                        android:layout_marginBottom="8dp" />

                    <ImageView
                        android:id="@+id/ivArchitectureDesign"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/description_img"
                        android:layout_marginBottom="16dp"
                        android:background="@android:color/darker_gray"
                        android:padding="5dp" />

                </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:background="@android:color/darker_gray"
                        android:layout_marginBottom="10dp"/>

                <LinearLayout
                    android:id="@+id/layout_materials"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center_horizontal"
                    android:background="@android:color/white">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Select Materials Needed"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorPrimaryDark"
                        android:paddingBottom="8dp" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:background="@android:color/darker_gray"
                        android:layout_marginBottom="10dp"/>

                    <!-- Checkboxes in Two Columns -->
                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:rowCount="3"
                        android:layout_marginBottom="16dp"
                        android:alignmentMode="alignMargins"
                        android:padding="4dp"
                        android:columnOrderPreserved="false">

                        <CheckBox
                            android:id="@+id/chk_material1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Scaffolding"
                            android:layout_marginEnd="20dp"/>

                        <CheckBox
                            android:id="@+id/chk_material2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Power Drill"
                            android:layout_marginStart="20dp"/>

                        <CheckBox
                            android:id="@+id/chk_material3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Angle Grinder"
                            android:layout_marginEnd="20dp"/>

                        <CheckBox
                            android:id="@+id/chk_material4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Silicon"
                            android:layout_marginStart="20dp"/>

                        <CheckBox
                            android:id="@+id/chk_material5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Measuring Tape"
                            android:layout_marginEnd="20dp"/>

                        <CheckBox
                            android:id="@+id/chk_material6"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rivet Gun"
                            android:layout_marginStart="20dp"/>

                    </GridLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Material"
                        android:paddingBottom="2dp"
                        android:visibility="gone">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edt_materials"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <ProgressBar
                        android:visibility="gone"
                        android:id="@+id/progressBar1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <Button
                        android:id="@+id/btn_submit_materials"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Submit Materials"
                        android:layout_marginTop="16dp"
                        android:backgroundTint="@color/colorPrimaryDark"
                        android:textColor="@android:color/white" />
                </LinearLayout>


                    <LinearLayout
                        android:id="@+id/layout_remarks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:gravity="center_horizontal"
                        android:background="@android:color/white">

                        <!-- Feedback Section -->
                        <TextView
                            android:id="@+id/txt_remarks"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Complete Service"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/colorPrimaryDark"
                            android:layout_marginBottom="8dp" />

                        <EditText
                            android:id="@+id/edt_remarks"
                            android:layout_width="match_parent"
                            android:layout_height="100dp"
                            android:hint="Enter your Remarks here..."
                            android:gravity="top|start"
                            android:background="@android:drawable/edit_text"
                            android:padding="10dp"
                            android:layout_marginBottom="16dp" />

                        <!-- Confirm and Approval Buttons -->
                        <Button
                            android:id="@+id/btn_completion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Confirm Completion"
                            android:backgroundTint="@color/colorAccent"
                            android:textColor="@android:color/white"
                            android:padding="12dp"
                            android:layout_marginBottom="8dp" />

                        <ProgressBar
                            android:visibility="gone"
                            android:id="@+id/progressBar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>
        </LinearLayout>

    </androidx.core.widget.NestedScrollView>
</RelativeLayout>
