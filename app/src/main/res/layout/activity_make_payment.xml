<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/layout_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ProgressBar
            android:id="@+id/progressCheckout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/layout_checkout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp"
                android:layout_marginBottom="84dp">

                <!-- CARD 1: DELIVERY DETAILS -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardElevation="6dp"
                    app:cardUseCompatPadding="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Delivery Details"
                            android:textStyle="bold"
                            android:textColor="@color/colorBlack"
                            android:textSize="16sp"
                            android:paddingBottom="8dp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="County">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edt_county"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:focusable="false"
                                android:clickable="true" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Town">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edt_town"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:focusable="false"
                                android:clickable="true" />

                            <ProgressBar
                                android:id="@+id/progressBarTown"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:visibility="gone" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Address">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edt_Address"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Select Expected Date"
                            android:paddingBottom="10dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edt_expected_date"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="text" />
                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- CARD: Shipping Option -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    app:cardElevation="6dp"
                    app:cardUseCompatPadding="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Shipping"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="@color/colorBlack"
                            android:paddingBottom="8dp" />

                        <RadioGroup
                            android:id="@+id/rg_shipping"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp">

                            <RadioButton
                                android:id="@+id/rb_shipping_yes"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Include Shipping"
                                android:textColor="@color/colorBlack"
                                android:buttonTint="@color/purple" />

                            <RadioButton
                                android:id="@+id/rb_shipping_no"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="No Shipping"
                                android:layout_marginStart="24dp"
                                android:textColor="@color/colorBlack"
                                android:buttonTint="@color/purple" />
                        </RadioGroup>

                        <!-- Optional: Display shipping fee dynamically -->
                        <TextView
                            android:id="@+id/txv_shipping_option_fee"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Shipping Fee: KES 300"
                            android:textSize="14sp"
                            android:textColor="@color/colorBlack"
                            android:paddingTop="4dp"
                            android:visibility="gone" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>


                <!-- CARD 2: PAYMENT -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardElevation="6dp"
                    app:cardUseCompatPadding="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Payment"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="@color/colorBlack"
                            android:paddingBottom="8dp" />

                        <!-- Base cart total coming from previous screen -->
                        <TextView
                            android:id="@+id/txv_items_total"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Items Total: KES 0"
                            android:textStyle="bold"
                            android:textColor="@color/colorBlack"
                            android:textSize="15sp"
                            android:paddingBottom="4dp" />

                        <!-- Default shipping fee (KES 300) -->
                        <TextView
                            android:id="@+id/txv_shipping_fee"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Shipping: KES 300"
                            android:textColor="@color/colorBlack"
                            android:textSize="14sp"
                            android:paddingBottom="8dp" />

                        <!-- Final amount user will pay (items + shipping) -->
                        <TextView
                            android:id="@+id/txv_amount_to_pay"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Amount to Pay: KES 0"
                            android:textStyle="bold"
                            android:textColor="@color/colorBlack"
                            android:textSize="16sp"
                            android:paddingBottom="6dp" />

                        <RadioGroup
                            android:id="@+id/pay_group"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingTop="4dp"
                            android:paddingBottom="6dp">

                            <RadioButton
                                android:id="@+id/rb_mpesa"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mpesa" />

                            <RadioButton
                                android:id="@+id/rb_bank"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Bank"
                                android:layout_marginStart="24dp" />
                        </RadioGroup>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/til_reference"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Payment Reference Code">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edt_mpesaCode"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />
                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </ScrollView>

        <!-- Bottom action bar -->
        <RelativeLayout
            android:id="@+id/layout_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:padding="10dp">

            <Button
                android:id="@+id/btn_order"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Confirm Payment"
                android:textColor="@color/colorWhite"
                android:backgroundTint="@color/purple" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </RelativeLayout>

    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
